# Reserve-a-Lab: compression, browser caching and WebP negotiation.
# Every block is wrapped in <IfModule>, so this file is safe on a server
# that lacks one of the modules (that feature is then simply skipped).
# PHP/HTML responses get no cache headers here: PHP sessions already send
# "Cache-Control: no-store, no-cache, must-revalidate".

# ---------------------------------------------------------------------------
# MIME types (most are already in Apache's mime.types; listed for servers
# with an older mime.types)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# ---------------------------------------------------------------------------
# Rewrites: block private files and folders, WebP negotiation (internal
# rewrites only). Access rules use mod_rewrite's [F] (403) rather than
# Options/Require, so they need no AllowOverride beyond what the rest of this
# file already uses (FileInfo).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # tools/ holds command-line scripts only: no web access (403).
    # NC and the optional trailing dots/spaces cover Windows path aliases
    # such as "Tools/" or "tools./".
    RewriteRule ^tools[.\s]*(?:/|$) - [NC,F]

    # Development-only folders (Composer packages, notes, video project):
    # no web access either. PHP still loads vendor/ from disk.
    RewriteRule ^(?:vendor|graphify-out|videos)[.\s]*(?:/|$) - [NC,F]

    # Database backups, lock files, notes and other non-web files, dotfiles
    # (.git/, .gitignore) and Windows 8.3 short names ("DB_BAC~1.SQL", which
    # could otherwise reach any of these under a different name).
    RewriteRule \.(?:sql|lock|md|log|bak|ini|env|sh|ps1|py|cjs|mjs)[.\s]*$ - [NC,F]
    RewriteRule (?:^|/)(?:composer|package|package-lock)\.json[.\s]*$ - [NC,F]
    RewriteRule (?:^|/)\. - [F]
    RewriteRule ~[0-9] - [F]

    # Uploaded content lives under img/ and is never code: refuse any script
    # type there, including double extensions such as "x.php.jpg" and
    # "x.php.", so a disguised upload cannot be run even if it got through.
    RewriteRule ^img/(?:.*/)?[^/]*\.(?:php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp)(?:\.|/|$) - [NC,F]

    # No directory listings: a folder without an index page is 403.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php !-f
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^ - [F]

    # Every original JPEG/PNG under img/ (but not img/_opt/) is marked, so its
    # response gets "Vary: Accept" (see mod_headers below), whether or not a
    # WebP mirror is served for it.
    RewriteRule ^img/(?!_opt/).+\.(?:jpe?g|png)$ - [NC,E=RAL_IMG_VARY:1]

    # WebP mirror: serve img/_opt/<rel>.webp in place of img/<rel> when the
    # browser accepts WebP and the mirror file exists. Query strings are kept.
    # Line 2 finds this directory's filesystem path (%2), so the -f check
    # works wherever the project is installed. Paths containing % ? or # are
    # left alone (the original is served).
    RewriteCond %{HTTP_ACCEPT} image/webp [NC]
    RewriteCond $0#%{REQUEST_FILENAME} ^([^#]+)#(.*)\1$
    RewriteCond %2img/_opt/$1.webp -f
    RewriteRule ^img/((?!_opt/)[^%?#]+\.(?:jpe?g|png))$ img/_opt/$1.webp [NC,E=RAL_WEBP:1,L]
</IfModule>

# ---------------------------------------------------------------------------
# Compression: Brotli first, gzip as fallback. Only one encoding is ever
# applied (each filter skips a response that is already encoded), and both
# add "Vary: Accept-Encoding". Already-compressed types (images, woff/woff2,
# PDF, downloads) are not listed, so they are never compressed.
# ---------------------------------------------------------------------------
<IfModule mod_setenvif.c>
    # .svgz is image/svg+xml but already gzipped
    SetEnvIfNoCase Request_URI "\.svgz$" no-gzip no-brotli
</IfModule>

<IfModule mod_filter.c>
    <IfModule mod_brotli.c>
        AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml text/javascript application/javascript application/x-javascript application/json image/svg+xml font/ttf font/otf application/x-font-ttf application/vnd.ms-fontobject
    </IfModule>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml text/javascript application/javascript application/x-javascript application/json image/svg+xml font/ttf font/otf application/x-font-ttf application/vnd.ms-fontobject
    </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# Browser caching (static files only; .php is never matched)
#   ?v=... (versioned URL)              1 year, immutable
#   assets/vendor/**, assets/fonts/**   1 year
#   fonts (woff2, woff, ttf, otf, eot)  1 year
#   images                              30 days
#   other CSS/JS                        1 day
# Later "Header set" lines override earlier ones.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # WebP negotiation: the original and the mirror both vary on Accept
    # (after the internal rewrite the variable carries a REDIRECT_ prefix).
    Header merge Vary Accept env=RAL_IMG_VARY
    Header merge Vary Accept env=REDIRECT_RAL_IMG_VARY

    <FilesMatch "\.(?i:jpe?g|png|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(?i:css|js|mjs)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(?i:woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(?i:css|js|mjs|map|json|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000" "expr=%{REQUEST_URI} =~ m#/assets/(?:vendor|fonts)/#"
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(?:^|&)v=/"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
#   nosniff            a file is never treated as a different type than it is served as
#   X-Frame-Options    only this site may frame its pages (clickjacking)
#   Referrer-Policy    approval links carry ?token=...; other sites only learn the origin
#   Permissions-Policy camera stays available to the barcode scanner, nothing else is
#   HSTS               sent only over HTTPS
#   CSP                scripts, styles, images, fonts, XHR and forms stay on this site; no
#                      plug-ins; no <base> tricks. Pages use inline scripts and styles, so
#                      'unsafe-inline' is still needed. Left out (RAL_NO_CSP): games/, which
#                      holds third-party games that load files from their own CDNs, and
#                      controller_dashboard.php, which sends its own CSP for CodeMirror
#                      (two policies would both apply, and the stricter one would win).
# ---------------------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "/games/" RAL_NO_CSP
    SetEnvIf Request_URI "/controller_dashboard\.php$" RAL_NO_CSP
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" env=!RAL_NO_CSP
</IfModule>

# Fallback when mod_headers is missing but mod_expires is present:
# type-based lifetimes only (no ?v= distinction). PHP output (text/html,
# application/json) is not listed, so it is not affected.
<IfModule !mod_headers.c>
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType image/jpeg "access plus 30 days"
        ExpiresByType image/png "access plus 30 days"
        ExpiresByType image/gif "access plus 30 days"
        ExpiresByType image/webp "access plus 30 days"
        ExpiresByType image/avif "access plus 30 days"
        ExpiresByType image/svg+xml "access plus 30 days"
        ExpiresByType image/x-icon "access plus 30 days"
        ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
        ExpiresByType text/css "access plus 1 day"
        ExpiresByType text/javascript "access plus 1 day"
        ExpiresByType application/javascript "access plus 1 day"
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/ttf "access plus 1 year"
        ExpiresByType font/otf "access plus 1 year"
        ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    </IfModule>
</IfModule>
