Options -Indexes

# Deny direct access to uploads of PHP files
<FilesMatch "\.php$">
  <If "%{REQUEST_URI} =~ m|^/uploads/|">
    Deny from all
  </If>
</FilesMatch>

# Protect includes directory
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^sql/ - [F,L]
</IfModule>
